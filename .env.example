# ---------------------------------------------------------------------------
# ajc-dev_caller — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Twilio Programmable Voice (required) ---------------------------------
# Find these in the Twilio Console (https://console.twilio.com).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Outbound caller ID. Must be an E.164 number you own/verified on Twilio,
# or one that is verified for your account.
TWILIO_FROM_NUMBER=+15551234567

# --- Public tunnel (required for Twilio to reach your local server) -------
# ngrok is the default. A free ngrok account provides an authtoken:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken

# --- Deepgram (speech-to-text and text-to-speech) -------------------------
# https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- OpenAI (LLM that decides what the agent says) ------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
