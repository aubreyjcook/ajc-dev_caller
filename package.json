{
  "name": "ajc-dev-caller",
  "version": "0.1.0",
  "description": "Outbound AI voice agent CLI: places PSTN calls via Twilio Programmable Voice and runs a real-time speech-to-speech agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ajc-caller": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.9",
    "openai": "^7.53.0",
    "twilio": "^6.3.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
